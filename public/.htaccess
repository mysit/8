<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Если это реальный файл или папка (например, css/style.css) — отдаем его сразу
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    
    # Всё остальное перенаправляем в index.php
    RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>
